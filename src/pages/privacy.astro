---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const effective = '11 November 2026';

const sections = [
  { id: 'overview', title: 'Overview' },
  { id: 'collect', title: 'Information we collect' },
  { id: 'use', title: 'How we use information' },
  { id: 'legal-basis', title: 'Legal bases (UK & EU)' },
  { id: 'sharing', title: 'Sharing & third parties' },
  { id: 'permissions', title: 'Device permissions' },
  { id: 'tracking', title: 'Analytics & tracking' },
  { id: 'retention', title: 'Data retention' },
  { id: 'security', title: 'Security' },
  { id: 'rights', title: 'Your rights' },
  { id: 'deletion', title: 'Account & data deletion' },
  { id: 'children', title: 'Children' },
  { id: 'transfers', title: 'International transfers' },
  { id: 'changes', title: 'Changes to this policy' },
  { id: 'contact', title: 'Contact us' },
];
---

<Base
  fullTitle="Privacy Policy — Meo Technologies Apps & Website"
  description={`Privacy Policy for ${SITE.name} iOS & Android apps and website: what data we collect, how it's used, your UK GDPR rights and how to delete your account.`}
  breadcrumbs={[{ name: 'Privacy Policy', path: '/privacy/' }]}
>
  <section class="intro">
    <div class="glow" aria-hidden="true"></div>
    <div class="container">
      <span class="eyebrow" data-reveal>Legal</span>
      <h1 data-split data-serif="policy">Privacy Policy</h1>
      <p class="meta" data-reveal style="--d:300">
        Effective {effective} · Applies to all {SITE.name} mobile apps, websites and services
      </p>
      <div class="summary" data-reveal style="--d:450">
        <div class="pill"><strong>We never sell</strong><span>your personal data</span></div>
        <div class="pill"><strong>You stay in control</strong><span>access, export or delete anytime</span></div>
        <div class="pill"><strong>Encrypted</strong><span>in transit and at rest</span></div>
      </div>
    </div>
  </section>

  <div class="container layout">
    <aside class="toc" aria-label="On this page">
      <span class="toc-label">On this page</span>
      <nav>
        {sections.map((s, i) => <a href={`#${s.id}`} data-toc={s.id}><span>{String(i + 1).padStart(2, '0')}</span>{s.title}</a>)}
      </nav>
    </aside>

    <article class="prose">
      <section id="overview" data-reveal>
        <h2>1. Overview</h2>
        <p>
          {SITE.name} (“<strong>Meo</strong>”, “<strong>we</strong>”, “<strong>us</strong>”) builds software and mobile
          applications. This Privacy Policy explains what personal information we collect when you use our apps
          (including those distributed through the Apple App Store and Google Play), our website and related services
          (together, the “<strong>Services</strong>”), how we use it, and the choices you have.
        </p>
        <p>
          Where we build an app on behalf of a client business, that business may be the data controller and its own
          privacy policy will also apply. In that case, we process data on its instructions as a data processor.
        </p>
      </section>

      <section id="collect" data-reveal>
        <h2>2. Information we collect</h2>
        <h3>Information you provide</h3>
        <ul>
          <li><strong>Account details</strong> — such as your name, email address and password (stored hashed) when you create an account.</li>
          <li><strong>Profile & content</strong> — information you choose to add, such as a profile photo, preferences, messages or files.</li>
          <li><strong>Support & communications</strong> — the content of messages you send us, including feedback and support requests.</li>
          <li><strong>Payments</strong> — in-app purchases are processed by Apple or Google. We receive confirmation of purchase, but never your full card details.</li>
        </ul>
        <h3>Information collected automatically</h3>
        <ul>
          <li><strong>Device information</strong> — device model, operating system version, app version, language and time zone.</li>
          <li><strong>Usage data</strong> — features used, screens viewed, and interactions, used to improve the Services.</li>
          <li><strong>Diagnostics</strong> — crash logs and performance data that help us fix bugs.</li>
          <li><strong>Identifiers</strong> — an app-specific identifier and, only where you allow it, push notification tokens.</li>
        </ul>
        <h3>Information we do not collect</h3>
        <p>
          Unless an app clearly asks for it and you grant permission, we do not collect precise location, contacts,
          photos, health data or other sensitive categories of information.
        </p>
      </section>

      <section id="use" data-reveal>
        <h2>3. How we use information</h2>
        <ul>
          <li>To provide, maintain and secure the Services and your account.</li>
          <li>To process transactions and deliver features you request.</li>
          <li>To respond to support requests and send service-related messages.</li>
          <li>To understand usage, diagnose problems and improve performance.</li>
          <li>To send product updates or marketing, only where you have opted in — you can unsubscribe anytime.</li>
          <li>To prevent fraud and abuse and to comply with legal obligations.</li>
        </ul>
        <p>We do not use your personal data for automated decision-making that has legal or similarly significant effects on you.</p>
      </section>

      <section id="legal-basis" data-reveal>
        <h2>4. Legal bases (UK & EU)</h2>
        <p>Under the UK GDPR and EU GDPR, we rely on the following legal bases:</p>
        <ul>
          <li><strong>Contract</strong> — to provide the Services you have asked for.</li>
          <li><strong>Legitimate interests</strong> — to keep the Services secure and improve them, balanced against your rights.</li>
          <li><strong>Consent</strong> — for optional analytics, marketing and device permissions. You can withdraw consent at any time.</li>
          <li><strong>Legal obligation</strong> — where we must keep or disclose information by law.</li>
        </ul>
      </section>

      <section id="sharing" data-reveal>
        <h2>5. Sharing & third parties</h2>
        <p><strong>We do not sell or rent your personal data.</strong> We share it only with:</p>
        <ul>
          <li><strong>Service providers</strong> — trusted vendors for hosting, databases, email delivery, crash reporting and analytics, bound by contracts to protect your data and use it only on our instructions.</li>
          <li><strong>App stores</strong> — Apple and Google process purchases and downloads under their own privacy policies.</li>
          <li><strong>Client businesses</strong> — where an app is operated for a client, the relevant data is shared with that client.</li>
          <li><strong>Legal & safety</strong> — when required by law, or to protect the rights, property or safety of users or others.</li>
          <li><strong>Business transfers</strong> — in connection with a merger or acquisition, with notice to you.</li>
        </ul>
      </section>

      <section id="permissions" data-reveal>
        <h2>6. Device permissions</h2>
        <p>
          Some features may ask for access to your camera, photos, microphone, notifications or location. We only
          request a permission when you use the feature that needs it, and we explain why. You can change permissions
          at any time in your device settings; the rest of the app will keep working.
        </p>
      </section>

      <section id="tracking" data-reveal>
        <h2>7. Analytics & tracking</h2>
        <p>
          We use privacy-focused analytics to understand how the Services perform. We do not track you across apps
          or websites owned by other companies for advertising purposes. If an app ever needs to do so, it will ask
          for your permission first through Apple’s App Tracking Transparency prompt or the equivalent Android
          setting.
        </p>
        <p>Our website uses only essential cookies unless you consent to more.</p>
      </section>

      <section id="retention" data-reveal>
        <h2>8. Data retention</h2>
        <p>
          We keep personal data only for as long as your account is active or as needed to provide the Services.
          When you delete your account, we delete or anonymise your personal data within 30 days, except where we
          must keep certain records for legal, tax or security reasons. Backups are cycled out within 90 days.
        </p>
      </section>

      <section id="security" data-reveal>
        <h2>9. Security</h2>
        <p>
          We protect data with encryption in transit (TLS) and at rest, access controls, least-privilege
          permissions and regular security reviews. No system is perfectly secure, but we work hard to protect your
          information and will notify you and the relevant authorities of any breach as required by law.
        </p>
      </section>

      <section id="rights" data-reveal>
        <h2>10. Your rights</h2>
        <p>Depending on where you live, you may have the right to:</p>
        <ul>
          <li>Access the personal data we hold about you and receive a copy.</li>
          <li>Correct inaccurate or incomplete data.</li>
          <li>Delete your data (“right to be forgotten”).</li>
          <li>Restrict or object to certain processing.</li>
          <li>Receive your data in a portable format.</li>
          <li>Withdraw consent at any time.</li>
          <li>For California residents (CCPA/CPRA): know, delete, correct and opt out of the sale or sharing of personal information. We do not sell or share personal information as those terms are defined.</li>
        </ul>
        <p>
          To exercise any right, contact us at <a href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a>. We
          respond within one month. You also have the right to complain to a supervisory authority — in the UK, the
          Information Commissioner’s Office (<a href="https://ico.org.uk" target="_blank" rel="noopener">ico.org.uk</a>).
        </p>
      </section>

      <section id="deletion" data-reveal>
        <h2>11. Account & data deletion</h2>
        <div class="callout">
          <p>You can delete your account and associated data at any time:</p>
          <ol>
            <li><strong>In the app</strong> — go to <em>Settings → Account → Delete account</em> and confirm.</li>
            <li>
              <strong>By email</strong> — send a request from your account email to{' '}
              <a href={`mailto:${SITE.privacyEmail}?subject=Account%20deletion%20request`}>{SITE.privacyEmail}</a>
              with the subject “Account deletion request” and the name of the app.
            </li>
          </ol>
          <p>
            We will confirm and complete deletion within 30 days. Deleting the app from your device does not delete
            your account. Active subscriptions must be cancelled separately through the App Store or Google Play.
          </p>
        </div>
      </section>

      <section id="children" data-reveal>
        <h2>12. Children</h2>
        <p>
          Our Services are not directed at children under 13 (or the minimum age in your country). We do not
          knowingly collect personal data from children. If you believe a child has given us personal data, contact
          us and we will delete it promptly.
        </p>
      </section>

      <section id="transfers" data-reveal>
        <h2>13. International transfers</h2>
        <p>
          We are based in the United Kingdom. Where data is transferred outside the UK or EEA, we use appropriate
          safeguards such as the UK International Data Transfer Agreement or EU Standard Contractual Clauses.
        </p>
      </section>

      <section id="changes" data-reveal>
        <h2>14. Changes to this policy</h2>
        <p>
          We may update this policy from time to time. We will post the new version here with a new effective date
          and, for significant changes, notify you in the app or by email before they take effect.
        </p>
      </section>

      <section id="contact" data-reveal>
        <h2>15. Contact us</h2>
        <div class="contact-card card">
          <div>
            <span class="label">Privacy enquiries</span>
            <a href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a>
          </div>
          <div>
            <span class="label">General</span>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </div>
          <div>
            <span class="label">Location</span>
            <span>{SITE.name}, {SITE.location}</span>
          </div>
        </div>
      </section>
    </article>
  </div>
</Base>

<script>
  function activeToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    if (!links.length) return;
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.dataset.toc!, l));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            map.get(e.target.id)?.classList.add('active');
          }
        });
      },
      { rootMargin: '-35% 0px -60% 0px' },
    );
    map.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', activeToc);
</script>

<style>
  .intro { position: relative; padding: 180px 0 70px; overflow: hidden; border-bottom: 1px solid var(--line); }
  .glow {
    position: absolute;
    width: 700px;
    height: 700px;
    right: -200px;
    top: -300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 124, 255, 0.35), transparent 65%);
    filter: blur(40px);
    animation: float 14s ease-in-out infinite alternate;
  }
  @keyframes float { to { transform: translate(-80px, 60px) scale(1.1); } }
  .intro .container { position: relative; }
  h1 { margin-top: 24px; font-size: clamp(52px, 9vw, 120px); letter-spacing: -0.055em; }
  h1 :global(.serif) { color: var(--accent); }
  .meta { margin-top: 20px; color: var(--muted); font-family: var(--font-mono); font-size: 13px; }
  .summary { margin-top: 44px; display: flex; flex-wrap: wrap; gap: 12px; }
  .pill {
    display: flex;
    flex-direction: column;
    padding: 16px 22px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
  }
  .pill strong { font-weight: 500; font-size: 16px; }
  .pill span { color: var(--muted); }

  .layout { display: grid; grid-template-columns: 260px 1fr; gap: 72px; padding-top: 72px; }
  .toc { position: sticky; top: 120px; align-self: start; max-height: calc(100vh - 140px); overflow: auto; }
  .toc-label { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
  .toc nav { margin-top: 16px; display: flex; flex-direction: column; border-left: 1px solid var(--line); }
  .toc a {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 7px 0 7px 18px;
    font-size: 14px;
    color: var(--muted);
    transition: color 0.3s, transform 0.4s var(--ease-out);
  }
  .toc a span { font-family: var(--font-mono); font-size: 11px; color: var(--dim); padding-top: 2px; }
  .toc a::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.4s var(--ease-out);
  }
  .toc a:hover { color: var(--text); transform: translateX(3px); }
  .toc a:global(.active) { color: var(--text); }
  .toc a:global(.active)::before { transform: scaleY(1); }

  .prose { max-width: 720px; padding-bottom: 60px; }
  .prose section { padding-bottom: 56px; }
  .prose h2 { font-size: clamp(28px, 3.2vw, 38px); letter-spacing: -0.035em; margin-bottom: 20px; }
  .prose h3 { font-size: 19px; letter-spacing: -0.015em; margin: 28px 0 12px; }
  .prose p { color: #c9c8cf; margin-bottom: 16px; }
  .prose ul, .prose ol { margin: 0 0 16px; padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; color: #c9c8cf; }
  .prose ul li { position: relative; padding-left: 26px; }
  .prose ul li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.7em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    transform: rotate(45deg);
  }
  .prose ol { counter-reset: n; }
  .prose ol li { counter-increment: n; position: relative; padding-left: 36px; }
  .prose ol li::before {
    content: counter(n);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-family: var(--font-mono);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .prose strong { color: var(--text); font-weight: 500; }
  .prose a { color: var(--accent); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size 0.4s var(--ease-out); }
  .prose a:hover { background-size: 100% 1px; }
  .callout {
    padding: 28px;
    border-radius: 20px;
    border: 1px solid rgba(200, 245, 96, 0.3);
    background: linear-gradient(135deg, rgba(200, 245, 96, 0.07), rgba(139, 124, 255, 0.05));
  }
  .callout p:last-child { margin-bottom: 0; }
  .contact-card { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 28px; }
  .contact-card div { display: flex; flex-direction: column; gap: 6px; font-size: 15px; }
  .label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); }

  @media (max-width: 900px) {
    .intro { padding-top: 140px; }
    .layout { grid-template-columns: 1fr; gap: 32px; padding-top: 48px; }
    .toc { position: static; max-height: none; }
    .toc nav { display: grid; grid-template-columns: 1fr 1fr; border-left: 0; }
    .toc a { padding-left: 0; }
    .toc a::before { display: none; }
    .contact-card { grid-template-columns: 1fr; }
  }
</style>
