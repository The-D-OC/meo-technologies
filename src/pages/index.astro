---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const capabilities = [
  'Web platforms',
  'iOS & Android apps',
  'Custom software',
  'AI & automation',
  'Cloud infrastructure',
  'Product design',
  'APIs & integrations',
  'Internal tools',
];

const services = [
  {
    n: '01',
    title: 'Custom software',
    body: 'Bespoke systems shaped around how your business actually works — not the other way round.',
    icon: 'M4 7h16M4 12h10M4 17h7M17 14l3 3-3 3',
  },
  {
    n: '02',
    title: 'Mobile apps',
    body: 'Native-quality iOS and Android apps, shipped to the App Store and Google Play and supported after launch.',
    icon: 'M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM11 18h2',
  },
  {
    n: '03',
    title: 'Web platforms',
    body: 'Fast, accessible websites, portals and SaaS products engineered to scale with your customers.',
    icon: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01',
  },
  {
    n: '04',
    title: 'AI & automation',
    body: 'Practical AI — assistants, document processing and workflow automation that save real hours every week.',
    icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  },
  {
    n: '05',
    title: 'Cloud & DevOps',
    body: 'Secure, observable infrastructure with automated deployments, monitoring and sensible costs.',
    icon: 'M7 18a4 4 0 0 1-.6-7.96A6 6 0 0 1 18 9a4.5 4.5 0 0 1-.5 9H7z',
  },
  {
    n: '06',
    title: 'Product design',
    body: 'Research-led UX and interface design that makes complex things feel effortless to use.',
    icon: 'M12 20l-8-8 8-8 8 8-8 8zM12 4v16M4 12h16',
  },
];

const steps = [
  {
    title: 'Discover',
    body: 'We dig into your goals, users and constraints, then map out a clear scope, timeline and fixed estimate.',
    tag: 'Week 1',
  },
  {
    title: 'Design',
    body: 'Wireframes become interactive prototypes you can click through and test before a line of production code.',
    tag: 'Weeks 2–3',
  },
  {
    title: 'Build',
    body: 'Two-week sprints with live demos, so you see progress constantly and can steer as priorities shift.',
    tag: 'Sprints',
  },
  {
    title: 'Launch & scale',
    body: 'We handle release, app store submission and monitoring — then keep improving with you after go-live.',
    tag: 'Ongoing',
  },
];

const products = [
  {
    kind: 'SaaS platforms',
    title: 'Subscription products your customers log into every day.',
    accent: 'var(--accent)',
  },
  {
    kind: 'Mobile apps',
    title: 'Apps that feel at home on every phone in your customers’ pockets.',
    accent: 'var(--violet)',
  },
  {
    kind: 'Internal tools',
    title: 'Dashboards and back-office systems that replace the spreadsheet chaos.',
    accent: 'var(--coral)',
  },
];

const stack = ['TypeScript', 'React', 'Astro', 'Swift', 'Kotlin', 'React Native', 'Node.js', 'Python', 'PostgreSQL', 'AWS', 'Vercel', 'Supabase'];

const faqs = [
  {
    q: 'How much does a project cost?',
    a: 'Every project is scoped individually. After a short discovery call we give you a clear, fixed estimate broken down by milestone — no surprise invoices.',
  },
  {
    q: 'Do we own the code?',
    a: 'Yes. You own all source code, designs and intellectual property we create for you, and everything lives in repositories you control.',
  },
  {
    q: 'Can you publish our app to the App Store and Google Play?',
    a: 'We handle the full release process: store listings, privacy disclosures, review submissions and updates after launch.',
  },
  {
    q: 'Do you support software after launch?',
    a: 'We offer flexible support and maintenance plans covering monitoring, security updates, bug fixes and new features.',
  },
];
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="orbs" aria-hidden="true" data-parallax="0.25">
      <span class="orb o1"></span><span class="orb o2"></span><span class="orb o3"></span>
    </div>
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="container hero-inner">
      <span class="eyebrow" data-reveal style="--d:0">Software studio · {SITE.location.split(',')[0]}</span>
      <h1 class="hero-title" data-split data-serif="moves,forward">We build software that moves business forward.</h1>
      <p class="lead" data-reveal style="--d:500">
        Meo Technologies designs, engineers and launches custom software, mobile apps and AI tools for
        businesses that refuse to stand still.
      </p>
      <div class="actions" data-reveal style="--d:650">
        <a href="#contact" class="btn btn-primary" data-magnetic>
          Start a project <span class="arrow">→</span>
        </a>
        <a href="#services" class="btn btn-ghost" data-magnetic>Explore services</a>
      </div>
    </div>

    <div class="container">
      <div class="showcase" data-reveal="scale" style="--d:800">
        <div class="window" data-tilt>
          <div class="win-bar"><i></i><i></i><i></i><span>meo.dashboard</span></div>
          <div class="win-body">
            <aside class="win-side">
              <b></b><b></b><b></b><b></b><b></b>
            </aside>
            <div class="win-main">
              <div class="kpis">
                <div><small>Active users</small><strong>Live</strong><em class="up">▲</em></div>
                <div><small>Deploys</small><strong>CI/CD</strong><em class="up">▲</em></div>
                <div><small>Uptime</small><strong>Stable</strong><em class="up">●</em></div>
              </div>
              <div class="chart" aria-hidden="true">
                {Array.from({ length: 18 }).map((_, i) => <span style={`--h:${30 + ((i * 37) % 60)}%;--i:${i}`}></span>)}
              </div>
            </div>
          </div>
        </div>
        <div class="float phone" data-parallax="-0.06">
          <div class="notch"></div>
          <div class="ph-line w70"></div>
          <div class="ph-card"></div>
          <div class="ph-line w50"></div>
          <div class="ph-line w80"></div>
          <div class="ph-btn"></div>
        </div>
        <div class="float chip" data-parallax="-0.1">
          <span class="pulse"></span> Build passing · v2.4.0
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee" aria-label="Capabilities">
    <div class="track">
      {
        [...capabilities, ...capabilities].map((c) => (
          <span class="item">
            {c}
            <i aria-hidden="true">✦</i>
          </span>
        ))
      }
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>What we do</span>
        <h2 data-split data-serif="end-to-end">Technology, built end-to-end.</h2>
        <p class="sub" data-reveal style="--d:200">
          From first sketch to millions of requests a day — one team, accountable for the whole thing.
        </p>
      </div>
      <div class="services">
        {
          services.map((s, i) => (
            <article class="card service" data-reveal style={`--d:${(i % 3) * 120}`}>
              <div class="svc-top">
                <span class="svc-icon">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={s.icon} />
                  </svg>
                </span>
                <span class="svc-n">{s.n}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="section process">
    <div class="container process-grid">
      <div class="process-head">
        <span class="eyebrow" data-reveal>How we work</span>
        <h2 data-split data-serif="clarity">Momentum with clarity.</h2>
        <p class="sub" data-reveal style="--d:200">
          A transparent process built to de-risk your investment and get you to launch faster.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i * 80}`}>
              <span class="step-n">0{i + 1}</span>
              <div>
                <div class="step-title">
                  <h3>{s.title}</h3>
                  <span class="tag">{s.tag}</span>
                </div>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section id="products" class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>What we create</span>
        <h2 data-split data-serif="ship">Products we design and ship.</h2>
      </div>
      <div class="products">
        {
          products.map((p, i) => (
            <article class="card product" data-reveal style={`--d:${i * 140};--c:${p.accent}`} data-tilt>
              <div class={`art art-${i}`} aria-hidden="true">
                <span />
                <span />
                <span />
                <span />
              </div>
              <span class="kind">{p.kind}</span>
              <h3>{p.title}</h3>
            </article>
          ))
        }
      </div>

      <div class="stats">
        <div class="stat" data-reveal>
          <strong><span data-count="2">0</span>-week</strong>
          <span>sprints with live demos</span>
        </div>
        <div class="stat" data-reveal style="--d:100">
          <strong><span data-count="100" data-suffix="%">0</span></strong>
          <span>code &amp; IP ownership for you</span>
        </div>
        <div class="stat" data-reveal style="--d:200">
          <strong><span data-count="24">0</span>h</strong>
          <span>response on support requests</span>
        </div>
        <div class="stat" data-reveal style="--d:300">
          <strong><span data-count="1">0</span> team</strong>
          <span>design, build &amp; launch</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="section stack-sec">
    <div class="container">
      <span class="eyebrow" data-reveal>Our toolkit</span>
      <ul class="stack" data-reveal style="--d:120">
        {stack.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow" data-reveal>Questions</span>
        <h2 data-split data-serif="asked">Frequently asked.</h2>
      </div>
      <div class="faqs">
        {
          faqs.map((f, i) => (
            <details class="faq" data-reveal style={`--d:${i * 80}`}>
              <summary>
                {f.q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="answer">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section">
    <div class="container">
      <div class="cta-card" data-reveal="scale">
        <div class="cta-glow" aria-hidden="true"></div>
        <span class="eyebrow">Let’s talk</span>
        <h2 data-split data-serif="next">Have an idea? Let’s build what’s next.</h2>
        <p class="sub">Tell us about your project and we’ll reply within one working day.</p>
        <div class="actions center">
          <a href={`mailto:${SITE.email}?subject=New%20project%20enquiry`} class="btn btn-primary" data-magnetic>
            {SITE.email} <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: 170px 0 60px;
    overflow: hidden;
  }
  .hero-inner { position: relative; z-index: 2; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hero-title {
    margin-top: 28px;
    font-size: clamp(46px, 8.4vw, 116px);
    max-width: 13ch;
    letter-spacing: -0.055em;
  }
  .hero-title :global(.serif) { color: var(--accent); padding-right: 0.04em; }
  .lead {
    margin-top: 28px;
    max-width: 54ch;
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--muted);
  }
  .actions { margin-top: 40px; display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  .orbs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    animation: drift 18s ease-in-out infinite alternate;
  }
  .o1 { width: 520px; height: 520px; background: var(--violet); top: -160px; left: -120px; opacity: 0.35; }
  .o2 { width: 420px; height: 420px; background: var(--accent); top: 80px; right: -140px; opacity: 0.22; animation-duration: 22s; animation-delay: -6s; }
  .o3 { width: 360px; height: 360px; background: var(--coral); top: 520px; left: 30%; opacity: 0.18; animation-duration: 26s; animation-delay: -12s; }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, 40px) scale(1.12); }
    100% { transform: translate(-40px, 80px) scale(0.95); }
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 30%, #000 20%, transparent 75%);
    opacity: 0.5;
  }

  /* Showcase */
  .showcase { position: relative; z-index: 2; margin: 90px auto 0; max-width: 1000px; }
  .window {
    border-radius: 20px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, rgba(25, 25, 36, 0.9), rgba(12, 12, 18, 0.95));
    box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
    overflow: hidden;
    transition: transform 0.8s var(--ease-out);
    will-change: transform;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 42px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
  }
  .win-bar i { width: 11px; height: 11px; border-radius: 50%; background: var(--line-strong); }
  .win-bar span { margin-left: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--dim); }
  .win-body { display: grid; grid-template-columns: 180px 1fr; min-height: 340px; }
  .win-side { border-right: 1px solid var(--line); padding: 22px 18px; display: flex; flex-direction: column; gap: 14px; }
  .win-side b { height: 10px; border-radius: 6px; background: var(--surface-2); }
  .win-side b:first-child { background: var(--accent); opacity: 0.85; width: 70%; }
  .win-side b:nth-child(3) { width: 80%; }
  .win-side b:nth-child(5) { width: 55%; }
  .win-main { padding: 22px; display: flex; flex-direction: column; gap: 22px; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .kpis div {
    position: relative;
    padding: 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .kpis small { font-size: 12px; color: var(--dim); }
  .kpis strong { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; }
  .kpis em { position: absolute; top: 14px; right: 14px; font-style: normal; font-size: 11px; color: var(--accent); }
  .chart {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    min-height: 150px;
    padding: 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .chart span {
    flex: 1;
    height: var(--h);
    border-radius: 6px 6px 2px 2px;
    background: linear-gradient(180deg, var(--accent), rgba(200, 245, 96, 0.15));
    transform-origin: bottom;
    animation: grow 1.4s var(--ease-out) both, breathe 4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * 60ms + 1.1s), calc(var(--i) * 180ms + 2.6s);
  }
  @keyframes grow { from { transform: scaleY(0); } }
  @keyframes breathe { to { transform: scaleY(0.78); } }

  .float {
    position: absolute;
    border: 1px solid var(--line-strong);
    background: rgba(18, 18, 26, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
  }
  .phone {
    right: -30px;
    bottom: -50px;
    width: 170px;
    height: 330px;
    border-radius: 30px;
    padding: 30px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: bob 7s ease-in-out infinite;
  }
  .notch { position: absolute; top: 10px; left: 50%; width: 54px; height: 8px; border-radius: 99px; background: var(--line-strong); transform: translateX(-50%); }
  .ph-line { height: 9px; border-radius: 6px; background: var(--surface-2); }
  .w50 { width: 50%; } .w70 { width: 70%; } .w80 { width: 80%; }
  .ph-card { height: 110px; border-radius: 16px; background: linear-gradient(135deg, var(--violet), var(--coral)); opacity: 0.85; }
  .ph-btn { margin-top: auto; height: 36px; border-radius: 99px; background: var(--accent); }
  .chip {
    left: -24px;
    top: 90px;
    padding: 12px 18px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: bob 6s ease-in-out infinite reverse;
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 rgba(200, 245, 96, 0.6); animation: pulse 2s infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 12px rgba(200, 245, 96, 0); } }
  @keyframes bob { 50% { transform: translateY(-14px); } }

  /* ---------- Marquee ---------- */
  .marquee {
    margin-top: 80px;
    border-block: 1px solid var(--line);
    padding: 26px 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track { display: flex; width: max-content; animation: scroll 38s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-size: clamp(24px, 3vw, 40px);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .item:nth-child(even) { font-family: var(--font-serif); font-style: italic; color: var(--muted); }
  .item i { font-style: normal; font-size: 0.5em; color: var(--accent); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* ---------- Sections ---------- */
  .section { padding: clamp(90px, 12vw, 150px) 0 0; }
  .section-head { display: flex; flex-direction: column; gap: 20px; max-width: 760px; margin-bottom: 64px; }
  h2 { font-size: clamp(40px, 6vw, 80px); letter-spacing: -0.05em; }
  h2 :global(.serif) { color: var(--accent); }
  .sub { color: var(--muted); font-size: 18px; max-width: 52ch; }

  /* Services */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .service { padding: 30px; min-height: 280px; display: flex; flex-direction: column; }
  .svc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: auto; }
  .svc-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    color: var(--accent);
    transition: transform 0.7s var(--ease-spring), background 0.4s, color 0.4s;
  }
  .service:hover .svc-icon { transform: rotate(-10deg) scale(1.08); background: var(--accent); color: var(--accent-ink); }
  .svc-n { font-family: var(--font-mono); font-size: 13px; color: var(--dim); }
  .service h3 { margin-top: 48px; font-size: 26px; }
  .service p { margin-top: 12px; color: var(--muted); font-size: 16px; }

  /* Process */
  .process-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; align-items: start; }
  .process-head { position: sticky; top: 140px; display: flex; flex-direction: column; gap: 20px; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 16px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }
  .step::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.4s var(--ease-out) 0.3s;
  }
  .step:global(.is-in)::after { transform: scaleX(1); }
  .step-n { font-family: var(--font-mono); font-size: 14px; color: var(--accent); padding-top: 8px; }
  .step-title { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .step h3 { font-size: clamp(28px, 3vw, 38px); }
  .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
  }
  .step p { margin-top: 12px; color: var(--muted); max-width: 48ch; }

  /* Products */
  .products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .product { padding: 22px; display: flex; flex-direction: column; gap: 14px; transition: transform 0.8s var(--ease-out), border-color 0.4s, background 0.4s; }
  .art {
    position: relative;
    aspect-ratio: 4 / 3.2;
    border-radius: 16px;
    background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--c) 35%, transparent), transparent 60%), var(--bg-2);
    border: 1px solid var(--line);
    overflow: hidden;
    margin-bottom: 10px;
  }
  .art span {
    position: absolute;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
