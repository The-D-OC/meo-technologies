---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import { SITE } from '../site';
import '../styles/global.css';

type Props = Partial<SEOProps> & {
  /** Short page name; rendered as "Name — Meo Technologies". Ignored if fullTitle is set. */
  title?: string;
  /** Exact <title>, for pages that want a hand-written keyword title. */
  fullTitle?: string;
};

const { title, fullTitle, description = SITE.description, ...seo } = Astro.props;
const pageTitle = fullTitle ?? (title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={pageTitle} description={description} {...seo} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#08080c" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" transition:name="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease-out);
  }
  .skip:focus { transform: none; }
</style>
